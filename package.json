{
  "name": "ilmora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:web": "npm run dev -w @ilmora/web",
    "build:web": "npm run build -w @ilmora/web"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^22.10.0",
    "playwright": "^1.64.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
