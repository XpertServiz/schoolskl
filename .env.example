# Copy to apps/web/.env.local (gitignored). Real values and secrets NEVER go in this template. Full list of variables: brief §21.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost           # e.g. ilmora.pk in production; tenants live at {slug}.<root>. Inlined at build time.
NEXT_PUBLIC_PRODUCT_NAME=Ilmora              # placeholder name; never hard-code
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — bypasses all row-level security. Webhook and job routes use it; it must never reach a browser, an app, or a shared file.
SUPABASE_SERVICE_ROLE_KEY=
# SERVER/TOOLS ONLY — used by packages/db/scripts (apply, verify). Never commit it.
SUPABASE_DB_URL=

# one secret per payment provider (HMAC webhook signing key from the provider dashboard); webhooks are rejected with 503 when unset
PROVIDER_SECRET_RAAST=
PROVIDER_SECRET_ONEBILL=
PROVIDER_SECRET_JAZZCASH=
PROVIDER_SECRET_EASYPAISA=
PROVIDER_SECRET_PAYFAST=
PROVIDER_SECRET_SAFEPAY=

# background jobs: POST /api/jobs/outbox and /api/jobs/nightly with  Authorization: Bearer $CRON_SECRET  (503 until a provider exists; NOTIFY_DRY_RUN=1 logs instead of sending)
CRON_SECRET=
NOTIFY_DRY_RUN=
